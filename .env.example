# Copy this file to .env and fill in your own values, then restart the dev server.
# Never commit the real .env file (it is already gitignored).

# Supabase project API URL -- NOT the dashboard URL.
# Find it in Supabase Dashboard -> Project Settings -> API -> Project URL.
# It must look like: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Browser-safe key. Either of these is accepted:
#   - Publishable key  (recommended, Settings -> API -> Publishable key)
#   - Legacy anon key  (Settings -> API -> anon / public)
# Never use the service_role / secret key here: it bypasses row level security
# and would expose a server-side secret to every visitor.
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
